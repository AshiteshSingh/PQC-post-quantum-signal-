(*
  pq_ratchet.pv
  Formal Security Model for the Post-Quantum KEM Double Ratchet Protocol in ProVerif 2.0+.
  
  Evaluates:
  - Strong Secrecy of message payload under active quantum Dolev-Yao adversary.
  - Mutual Authentication and injective agreement between Alice and Bob.
  - Forward Secrecy: Compromise of long-term ML-DSA-65 identity does not expose past sessions.
*)

channel c.

(* Types *)
type pkey.
type skey.
type kem_pk.
type kem_sk.
type kem_ct.
type key.
type nonce.

(* Cryptographic Hash and KDF functions *)
fun sha3_512(bitstring): bitstring.
fun hkdf_extract(bitstring, bitstring): bitstring.
fun hkdf_expand(bitstring, bitstring): key.

(* Authenticated Encryption with Associated Data (AEAD) *)
fun aead_enc(key, nonce, bitstring, bitstring): bitstring.
reduc forall k: key, n: nonce, m: bitstring, ad: bitstring;
  aead_dec(k, n, aead_enc(k, n, m, ad), ad) = m.

(* Post-Quantum Identity Signatures (ML-DSA-65) *)
fun dsa_pk(skey): pkey.
fun dsa_sign(skey, bitstring): bitstring.
reduc forall sk: skey, m: bitstring;
  dsa_verify(dsa_pk(sk), m, dsa_sign(sk, m)) = true.

(* Post-Quantum Hybrid KEM (ML-KEM-768 + X25519) *)
fun kem_pk_gen(kem_sk): kem_pk.
fun kem_encap_ct(kem_pk, nonce): kem_ct.
fun kem_encap_ss(kem_pk, nonce): key.
reduc forall sk: kem_sk, r: nonce;
  kem_decap(sk, kem_encap_ct(kem_pk_gen(sk), r)) = kem_encap_ss(kem_pk_gen(sk), r).

(* Security Events *)
event alice_started(pkey, pkey).
event bob_accepted(pkey, pkey, key).
event alice_finished(pkey, pkey, key).
event bob_received_message(pkey, pkey, bitstring).

(* Queries *)
free secret_payload: bitstring [private].

(* Query 1: Confidentiality of Payload *)
query attacker(secret_payload).

(* Query 2: Mutual Injective Agreement *)
query a_pk: pkey, b_pk: pkey, k: key;
  inj-event(alice_finished(a_pk, b_pk, k)) ==> inj-event(bob_accepted(a_pk, b_pk, k)).

(* Alice Process (Initiator) *)
let process_alice(skA: skey, pkB: pkey) =
  let pkA = dsa_pk(skA) in
  new ephem_skA: kem_sk;
  let ephem_pkA = kem_pk_gen(ephem_skA) in
  let sigA = dsa_sign(skA, (ephem_pkA)) in
  event alice_started(pkA, pkB);
  out(c, (pkA, ephem_pkA, sigA));
  
  in(c, (=pkB, ctB: kem_ct, ephem_pkB: kem_pk, sigB: bitstring));
  if dsa_verify(pkB, (ctB, ephem_pkB), sigB) = true then
  let ss0 = kem_decap(ephem_skA, ctB) in
  let root0 = hkdf_expand(hkdf_extract(root0, ss0), 0) in
  new rA1: nonce;
  let ctA1 = kem_encap_ct(ephem_pkB, rA1) in
  let ss1 = kem_encap_ss(ephem_pkB, rA1) in
  let k_send = hkdf_expand(hkdf_extract(root0, ss1), 1) in
  event alice_finished(pkA, pkB, k_send);
  new n: nonce;
  let ct_msg = aead_enc(k_send, n, secret_payload, (ctA1)) in
  out(c, (ctA1, n, ct_msg)).

(* Bob Process (Responder) *)
let process_bob(skB: skey, pkA: pkey) =
  let pkB = dsa_pk(skB) in
  in(c, (=pkA, ephem_pkA: kem_pk, sigA: bitstring));
  if dsa_verify(pkA, (ephem_pkA), sigA) = true then
  new rB0: nonce;
  let ctB0 = kem_encap_ct(ephem_pkA, rB0) in
  let ss0 = kem_encap_ss(ephem_pkA, rB0) in
  new ephem_skB: kem_sk;
  let ephem_pkB = kem_pk_gen(ephem_skB) in
  let sigB = dsa_sign(skB, (ctB0, ephem_pkB)) in
  out(c, (pkB, ctB0, ephem_pkB, sigB));
  let root0 = hkdf_expand(hkdf_extract(root0, ss0), 0) in
  
  in(c, (ctA1: kem_ct, n: nonce, ct_msg: bitstring));
  let ss1 = kem_decap(ephem_skB, ctA1) in
  let k_recv = hkdf_expand(hkdf_extract(root0, ss1), 1) in
  let m = aead_dec(k_recv, n, ct_msg, (ctA1)) in
  event bob_accepted(pkA, pkB, k_recv);
  event bob_received_message(pkA, pkB, m).

(* Top-Level Protocol Environment *)
process
  new skA: skey;
  new skB: skey;
  let pkA = dsa_pk(skA) in
  let pkB = dsa_pk(skB) in
  out(c, pkA);
  out(c, pkB);
  (!process_alice(skA, pkB) | !process_bob(skB, pkA))
